{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=4EPlatform.DigitalMedia.Circulars;Integrated Security=true;MultipleActiveResultSets=True;TrustServerCertificate=True;"

  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/apilog-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "RateLimit": {
    "PermitLimit": 5,
    "QueueLimit": 5,
    "WindowSeconds": 10
  },
  "CircularsUpload": {
    "allowedAttachmentExtensions": [ ".doc", ".docx", ".pdf", ".ppt", ".pptx", ".xls", ".xlsx", ".png", ".jpg", ".jpeg", ".svg", ".txt", ".csv", ".mp4", ".movin" ],
    "allowedImageExtensions": [ ".jpg", ".jpeg", ".png" ],
    "allowedVideoExtensions": [ ".mp4", ".webm" ],
    "maxFileSizes": {
      "image": 5242880, // 5MB
      "video": 20971520, // 20MB
      "attachment": 10485760 // 10MB
    }
  },
  "GrpcServiceSettings": {
    "UserManagementUrl": "http://localhost:7152",
    //"CPAggregatorUrl": "http://localhost:7067"
    "CPAggregatorUrl": "http://localhost:7286"
  },
  "AllowedHosts": "*",
  "IdentityUrl": "http://localhost:5111",
  "permesstionUrl": "http://localhost:5111/api/GetControllerAndActionName/AddPermession",
  "key": "52"
}